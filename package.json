{
  "name": "proworkio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @proworkio/web dev",
    "dev:admin": "pnpm --filter @proworkio/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @proworkio/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "pnpm codegen:openapi",
    "codegen:openapi": "openapi-typescript packages/openapi/spec/openapi.yaml -o packages/openapi/src/generated/schema.ts",
    "db:start": "pnpm dlx supabase@2.84.4 start",
    "db:stop": "pnpm dlx supabase@2.84.4 stop",
    "db:reset": "pnpm dlx supabase@2.84.4 db reset",
    "db:types": "pnpm dlx supabase@2.84.4 gen types typescript --local > packages/types/src/database.generated.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "turbo": "2.8.20",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
